pipeline {
    agent {
        // Jenkins Kubernetes plugin으로 Kaniko + Builder 포함된 Pod 띄우기
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-kaniko-websocket-client
spec:
  containers:
    - name: builder
      # ✅ Java 21 JDK 이미지
      image: eclipse-temurin:21-jdk-alpine
      command:
        - cat
      tty: true
    - name: kaniko
      image: gcr.io/kaniko-project/executor:debug
      command:
        - cat
      tty: true
      volumeMounts:
        - name: kcr-docker-config
          mountPath: /kaniko/.docker
  volumes:
    - name: kcr-docker-config
      secret:
        secretName: kcr-regcred
        items:
          - key: .dockerconfigjson
            path: config.json
'''
            // 기본 컨테이너는 builder (Gradle 빌드용)
            defaultContainer 'builder'
        }
    }

    environment {
        // Kakao Cloud Container Registry
        REGISTRY_HOST      = ''
        REGISTRY_NAMESPACE = 'dkaffeine'
        // websocket-client 이미지 이름 (values.yaml repository와 동일)
        SERVICE_NAME       = 'websocket-client'

        // GitHub Infra Repo
        GITHUB_CREDENTIAL  = 'kdyann'
        INFRA_REPO         = ''
    }

    stages {
        /* 1) Checkout websocket-client 서비스 레포 */
        stage('Checkout') {
            steps {
                echo "📦 Checking out websocket-client source code..."
                checkout scm
            }
            post {
                success { echo "✅ [Checkout] Git repository checkout success" }
                failure { echo "❌ [Checkout] Failed to checkout repository" }
            }
        }

        /* 2) Gradle Build (bootJar 생성) */
        stage('Gradle Build') {
            steps {
                echo "🛠 Running Gradle build (bootJar) for websocket-client..."
                container('builder') {
                    sh '''
                    set -e
                    ls -al
                    chmod +x ./gradlew
                    ./gradlew clean bootJar -x test
                    echo "✅ Gradle build complete. Built JARs:"
                    ls -al build/libs || echo "⚠️ build/libs not found"
                    '''
                }
            }
            post {
                success { echo "✅ [Gradle] bootJar build success" }
                failure { echo "❌ [Gradle] bootJar build failed" }
            }
        }

        /* 3) Docker Build & Push (Kaniko) */
        stage('Docker Build & Push (Kaniko)') {
            steps {
                echo "🐳 Building & Pushing websocket-client Docker image with Kaniko..."
                container('kaniko') {
                    sh '''
                    set -e
                    IMAGE_BASE=${REGISTRY_HOST}/${REGISTRY_NAMESPACE}/${SERVICE_NAME}
                    echo "IMAGE_BASE: ${IMAGE_BASE}"
                    echo "WORKSPACE : ${WORKSPACE}"
                    echo "📂 Check build/libs in workspace before Kaniko:"
                    ls -al build/libs || echo "⚠️ build/libs not found in workspace"

                    /kaniko/executor \
                      --context=${WORKSPACE} \
                      --dockerfile=${WORKSPACE}/Dockerfile \
                      --destination=${IMAGE_BASE}:${BUILD_NUMBER} \
                      --destination=${IMAGE_BASE}:latest \
                      --cache=false
                    '''
                }
            }
            post {
                success { echo "✅ [Kaniko] Image build & push success" }
                failure { echo "❌ [Kaniko] Image build & push failed" }
            }
        }

        /* 4) Helm values.yaml 업데이트 (Infra Repo) */
        stage('Update Helm values.yaml') {
            steps {
                echo "🧭 Updating websocket-client Helm values.yaml in infra repo..."
                container('builder') {
                    withCredentials([usernamePassword(
                            credentialsId: GITHUB_CREDENTIAL,
                            usernameVariable: 'GIT_USER',
                            passwordVariable: 'GIT_TOKEN'
                    )]) {
                        sh '''
                        set -e
                        echo "📦 Installing git in builder container..."
                        apk add --no-cache git

                        echo "📁 Move to workspace and clone infra repo..."
                        cd "$WORKSPACE"
                        rm -rf infra
                        git clone https://$GIT_USER:$GIT_TOKEN@github.com/dktechin-pbl/DKaffeine-Infra.git infra
                        cd infra

                        # ✅ Jenkins용 git 사용자 정보 설정 (이 레포에만)
                        git config user.email "ci@jenkins.local"
                        git config user.name "jenkins-ci"

                        # main 브랜치로 맞추기
                        git checkout main || git checkout -b main
                        git pull origin main || echo "No existing main branch"

                        # ✅ 실제 values.yaml 경로
                        TARGET_FILE=k8s/websocket-client/helm/values.yaml
                        echo "🎯 TARGET_FILE = $TARGET_FILE"

                        if [ -f "$TARGET_FILE" ]; then
                            echo "🔧 Before update ======================="
                            grep -n "tag:" "$TARGET_FILE" || echo "no tag line"

                            # tag: "latest" / tag: "33" 모두 처리
                            sed -i "s/^\\([[:space:]]*tag:\\)[[:space:]]*\".*\"/\\1 \"${BUILD_NUMBER}\"/" "$TARGET_FILE"

                            echo "🔧 After update ========================"
                            grep -n "tag:" "$TARGET_FILE" || echo "no tag line"

                            git status
                            git add "$TARGET_FILE"

                            if git diff --cached --quiet; then
                                echo "⚠️ No changes to commit"
                            else
                                git commit -m "[CI] Update websocket-client image tag to ${BUILD_NUMBER}"
                                git push origin main
                                echo "✅ Successfully pushed tag update to main branch"
                            fi
                        else
                            echo "⚠️ values.yaml not found at $TARGET_FILE! Skipping..."
                            exit 1
                        fi
                        '''
                    }
                }
            }
            post {
                success { echo "✅ [Helm Update] websocket-client values.yaml updated in infra repo!" }
                failure { echo "❌ [Helm Update] Failed to update infra repo!" }
            }
        }
    }

    post {
        success { echo "🎉 CI pipeline completed successfully for ${SERVICE_NAME}!" }
        failure { echo "🚨 CI pipeline failed for ${SERVICE_NAME}. Check logs above for details." }
    }
}